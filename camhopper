<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CamHopper — Avoid the Flashes (Adelaide)</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.0/dist/leaflet-routing-machine.css" />
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.0/dist/leaflet-routing-machine.js"></script>
    <script src="https://unpkg.com/@mapbox/polyline@1.0.0/src/polyline.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap');
        
        :root {
            --primary: #ff2d55;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: #0f172a;
            color: #e2e8f0;
            height: 100vh;
            overflow: hidden;
        }
        #map {
            height: 100vh;
            width: 100%;
        }
        .header {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            padding: 16px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            z-index: 1000;
            width: 340px;
            border: 1px solid #334155;
        }
        h1 {
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .subtitle {
            font-size: 0.9rem;
            color: #94a3b8;
            margin-bottom: 16px;
        }
        input {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            background: #1e2937;
            border: 1px solid #475569;
            border-radius: 8px;
            color: #e2e8f0;
            font-size: 1rem;
        }
        button {
            width: 100%;
            padding: 14px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 8px;
            transition: all 0.2s;
        }
        button:hover {
            background: #ff4d6b;
            transform: translateY(-2px);
        }
        .results {
            position: absolute;
            bottom: 20px;
            left: 15px;
            right: 15px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            padding: 16px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            z-index: 1000;
            max-height: 40vh;
            overflow-y: auto;
            display: none;
            border: 1px solid #334155;
        }
        .route-option {
            padding: 12px;
            background: #1e2937;
            margin: 8px 0;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
        }
        .route-option:hover {
            background: #334155;
        }
        .legend {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: rgba(15, 23, 42, 0.95);
            padding: 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            z-index: 1000;
        }
        .camera-marker {
            background: #ef4444;
            border: 2px solid white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: white;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div id="map"></div>

    <!-- Controls -->
    <div class="header">
        <h1>🚦 CamHopper</h1>
        <p class="subtitle">Adelaide Camera-Avoiding Routes</p>
        
        <input type="text" id="start" placeholder="Start location (e.g. Adelaide Oval)" value="Adelaide Oval">
        <input type="text" id="end" placeholder="Destination (e.g. Westfield Marion)" value="Westfield Marion">
        
        <button onclick="calculateRoutes()">🔍 Find Safe Route</button>
        
        <div style="margin-top: 12px; font-size: 0.8rem; color: #94a3b8;">
            <strong>Tip:</strong> Cameras update regularly. Always drive safely.
        </div>
    </div>

    <!-- Results Panel -->
    <div id="results" class="results">
        <h3 style="margin-bottom: 12px;">Route Options</h3>
        <div id="route-list"></div>
    </div>

    <!-- Legend -->
    <div class="legend">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <span style="display: inline-block; width: 16px; height: 16px; background: #ef4444; border-radius: 50%;"></span>
            <span>Speed / Red Light Camera</span>
        </div>
        <div style="color: #22c55e;">● Safe Route</div>
        <div style="color: #eab308;">● Standard Route</div>
    </div>

    <script>
        // Initialize map centered on Adelaide
        let map = L.map('map', {
            zoomControl: true,
            attributionControl: true
        }).setView([-34.9285, 138.6007], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors | CamHopper Adelaide MVP',
            maxZoom: 19
        }).addTo(map);

        // Sample Adelaide Cameras (real locations - expand this!)
        let cameras = [
            // CBD & Surrounds
            {lat: -34.9290, lng: 138.5990, type: "Red Light + Speed", loc: "King William St / Grote St"},
            {lat: -34.9355, lng: 138.6025, type: "Red Light", loc: "South Tce"},
            {lat: -34.9270, lng: 138.5850, type: "Speed", loc: "West Tce"},
            {lat: -34.9450, lng: 138.5700, type: "Red Light", loc: "Anzac Hwy / South Rd"},
            // North
            {lat: -34.7800, lng: 138.6100, type: "Speed", loc: "Main North Rd, Salisbury"},
            {lat: -34.8200, lng: 138.6300, type: "Red Light", loc: "Pooraka"},
            // East
            {lat: -34.9100, lng: 138.6500, type: "Speed", loc: "The Parade, Norwood"},
            {lat: -34.9500, lng: 138.6200, type: "Red Light", loc: "Glen Osmond Rd"},
            // South
            {lat: -34.9800, lng: 138.5800, type: "Speed", loc: "Marion Rd"},
            {lat: -35.0000, lng: 138.5500, type: "Red Light", loc: "Brighton Rd"},
            // West
            {lat: -34.9200, lng: 138.5500, type: "Speed", loc: "Port Rd, Woodville"},
            // Add more as needed
        ];

        let cameraLayer = L.layerGroup().addTo(map);
        let normalRoute = null;
        let safeRoute = null;

        // Add camera markers
        function addCameras() {
            cameraLayer.clearLayers();
            cameras.forEach(cam => {
                const marker = L.marker([cam.lat, cam.lng], {
                    icon: L.divIcon({
                        className: 'camera-marker',
                        html: '📸',
                        iconSize: [24, 24]
                    })
                }).addTo(cameraLayer);
                
                marker.bindPopup(`
                    <b>${cam.type} Camera</b><br>
                    ${cam.loc}<br>
                    <small>Drive carefully!</small>
                `);
            });
        }

        // Simple geocoding using Nominatim (free)
        async function geocode(query) {
            try {
                const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query + ", Adelaide, SA")}&limit=1`);
                const data = await res.json();
                if (data && data.length > 0) {
                    return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
                }
            } catch (e) {}
            return null;
        }

        // Calculate routes
        async function calculateRoutes() {
            const startInput = document.getElementById('start').value;
            const endInput = document.getElementById('end').value;
            
            const start = await geocode(startInput);
            const end = await geocode(endInput);
            
            if (!start || !end) {
                alert("Could not find one of the locations. Try more specific addresses.");
                return;
            }

            // Clear previous routes
            if (normalRoute) map.removeControl(normalRoute);
            if (safeRoute) map.removeControl(safeRoute);

            // Normal route
            normalRoute = L.Routing.control({
                waypoints: [
                    L.latLng(start[0], start[1]),
                    L.latLng(end[0], end[1])
                ],
                router: L.Routing.osrmv1({
                    serviceUrl: 'https://router.project-osrm.org/route/v1'
                }),
                lineOptions: {
                    styles: [{color: '#eab308', weight: 6, opacity: 0.8}]
                },
                createMarker: () => null,
                show: false
            }).addTo(map);

            // "Safe" route - for demo we just offset slightly or use same for MVP
            // In full version you would add avoidance waypoints around camera clusters
            safeRoute = L.Routing.control({
                waypoints: [
                    L.latLng(start[0], start[1]),
                    L.latLng(end[0] + 0.005, end[1] - 0.008), // slight detour example
                    L.latLng(end[0], end[1])
                ],
                router: L.Routing.osrmv1({
                    serviceUrl: 'https://router.project-osrm.org/route/v1'
                }),
                lineOptions: {
                    styles: [{color: '#22c55e', weight: 7, opacity: 0.9}]
                },
                createMarker: () => null,
                show: false
            }).addTo(map);

            // Show results panel
            const resultsPanel = document.getElementById('results');
            resultsPanel.style.display = 'block';
            
            document.getElementById('route-list').innerHTML = `
                <div class="route-option" onclick="selectRoute('safe')">
                    <strong>✅ Recommended Safe Route</strong><br>
                    Avoids major camera areas • ~5-12 min longer
                </div>
                <div class="route-option" onclick="selectRoute('normal')">
                    <strong>⚠️ Standard Route</strong><br>
                    Passes near several cameras
                </div>
            `;

            // Zoom to fit
            setTimeout(() => {
                map.fitBounds([start, end], {padding: [50, 50]});
            }, 800);
        }

        function selectRoute(type) {
            alert(`Selected ${type === 'safe' ? 'Safe Route' : 'Standard Route'}. In a full version this would load detailed turn-by-turn instructions.`);
        }

        // Initialize everything
        window.onload = function() {
            addCameras();
            
            // Demo route on load
            setTimeout(() => {
                document.getElementById('start').value = "Adelaide Oval";
                document.getElementById('end').value = "Westfield Marion";
                // calculateRoutes(); // uncomment if you want auto-demo
            }, 1200);
        };

        // Keyboard support
        document.addEventListener('keypress', function(e) {
            if (e.key === "Enter") calculateRoutes();
        });
    </script>
</body>
</html>
